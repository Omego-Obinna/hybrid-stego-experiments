# Build the other document when xr-hyper requests its label file.
# A child uses -norc to avoid a circular manuscript/supplement dependency.
use File::Basename;
use File::Copy qw(copy);
use Cwd qw(getcwd);
push @file_not_found, '^No file\s*(.+)\s*$';
add_cus_dep('tex', 'aux', 0, 'build_companion');
sub build_companion {
    my ($name) = @_;
    return 0 if $root_filename eq $name;
    my ($base, $dir) = fileparse($name);
    my $old = getcwd();
    chdir($dir) or return 1;
    my $out = ".crossref-$base";
    my $status = system('latexmk', '-norc', '-pdf', '-interaction=nonstopmode',
        '-halt-on-error', "-outdir=$out", "$base.tex");
    if ($status == 0) {
        copy("$out/$base.aux", "$base.aux") or $status = 1;
        copy("$out/$base.pdf", "$base.pdf") or $status = 1;
        rdb_add_generated("$out/$base.aux");
    }
    chdir($old);
    return $status;
}
